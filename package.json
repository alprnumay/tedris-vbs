{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:clean": "node scripts/kill-dev-ports.mjs",
    "dev:fresh": "pnpm run dev:clean && pnpm run dev",
    "dev:web": "set PORT=3000&& pnpm --filter @workspace/veli-bilgilendirme run dev",
    "dev:api": "set PORT=3001&& pnpm --filter @workspace/api-server run build && set PORT=3001&& pnpm --filter @workspace/api-server run start",
    "db:push": "pnpm --filter @workspace/db run push",
    "preinstall": "echo skip",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:api-server": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server run build",
    "build:veli-bilgilendirme": "pnpm run typecheck:libs && pnpm --filter @workspace/veli-bilgilendirme run build",
    "typecheck:libs": "tsc --build",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:libs && pnpm run typecheck:api && pnpm --filter @workspace/api-server --filter @workspace/veli-bilgilendirme --filter @workspace/mockup-sandbox --filter @workspace/scripts --if-present run typecheck",
    "qa": "node scripts/load-test/run-load-test.mjs",
    "test:load": "node scripts/load-test/run-load-test.mjs",
    "load-test": "node scripts/load-test/run-load-test.mjs",
    "load-test:api": "node scripts/load-test/run-load-test.mjs --api-only",
    "load-test:browser-only": "node scripts/load-test/run-load-test.mjs --browser-only",
    "load-test:browser": "pnpm dlx playwright test load-tests/playwright/png-whatsapp-export.spec.ts --config load-tests/playwright/playwright.config.ts",
    "load-test:50": "node scripts/load-test/run-load-test.mjs --profile=50",
    "load-test:100": "node scripts/load-test/run-load-test.mjs --profile=100",
    "load-test:250": "node scripts/load-test/run-load-test.mjs --profile=250",
    "load-test:500": "node scripts/load-test/run-load-test.mjs --profile=500",
    "load-test:cleanup": "node scripts/load-test/cleanup-load-test.mjs",
    "stress:25": "node scripts/stress-test/stress-test.mjs --mode=app --users=25",
    "stress:50": "node scripts/stress-test/stress-test.mjs --mode=app --users=50",
    "stress:100": "node scripts/stress-test/stress-test.mjs --mode=app --users=100",
    "stress:app:25": "node scripts/stress-test/stress-test.mjs --mode=app --users=25",
    "stress:app:50": "node scripts/stress-test/stress-test.mjs --mode=app --users=50",
    "stress:app:100": "node scripts/stress-test/stress-test.mjs --mode=app --users=100",
    "stress:auth:25": "node scripts/stress-test/stress-test.mjs --mode=auth --users=25",
    "stress:auth:50": "node scripts/stress-test/stress-test.mjs --mode=auth --users=50",
    "stress:auth:100": "node scripts/stress-test/stress-test.mjs --mode=auth --users=100",
    "repair:baglarbasi": "pnpm dlx tsx scripts/repair-single-baglarbasi-1163.ts",
    "generate:vapid": "pnpm --filter @workspace/api-server exec web-push generate-vapid-keys"
  },
  "private": true,
  "dependencies": {
    "pg": "^8.20.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}