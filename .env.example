# ─── Yerel geliştirme (örnek) ───────────────────────────────────────────────
# Kökten kopyalayın: cp .env.example artifacts/api-server/.env

# api-server (zorunlu)
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
ADMIN_EMAIL=admin@ornek.com
# İlk kurulum: local_users'ta admin yoksa API başlangıcında oluşturulur (mevcut şifreyi değiştirmez)
# ADMIN_BOOTSTRAP_PASSWORD=guclu_sifre

# CORS + cross-site sid cookie (farklı frontend/API originlerinde zorunlu)
# FRONTEND_URL=https://ornek-frontend.example.com
# CORS_ORIGINS=https://ornek-preview.example.com
# NODE_ENV=production
# SESSION_COOKIE_CROSS_SITE=true

# ─── Deploy (Build & Development Settings → Environment Variables) ─────────
VITE_API_BASE_URL=https://api.antalyanehari.xyz/api
VITE_PROJECT_API_KEY=your_project_api_key_here

# Veri onarımı (varsayılan kapalı — stabilizasyon)
# VITE_ENABLE_REPAIR=true
# VITE_REPAIR_API_BASE_URL=

# Vercel / api-server onarım function (sunucu tarafı)
# VPS_API_BASE_URL=https://api.antalyanehari.xyz/api
# VPS_PROJECT_API_KEY=your_project_api_key_here
# ADMIN_API_KEY=your_vps_admin_api_key

# Tek kayıt onarım script (scripts/repair-single-baglarbasi-1163.ts)
# ADMIN_JWT=<admin panel Bearer token>
# DRY_RUN=true

# ─── Yerel veli-bilgilendirme + Nehari /davet showcase (kök .env.local) ─────
# Yerel `npm run dev`: tarayıcı localhost'ta otomatik /api proxy → 127.0.0.1:3001 kullanır
# (VITE_API_BASE_URL burada VPS olsa bile). Canlı VPS'i dev'de zorlamak için:
# VITE_FORCE_REMOTE_API=true
# Yerel api-server çalışırken (PORT=3001): showcase istekleri doğrudan bu adrese gider.
# VITE_API_BASE_URL=http://localhost:3001/api
# Giriş de aynı API üzerinden yapılmalıdır (sessionToken → Authorization Bearer).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Anahtar üret: pnpm vapid:kurulum   (veya: pnpm generate:vapid)
#
# Zorunlu env (VPS api-server + Vercel — AYNI değerler):
#   VAPID_PUBLIC_KEY=...     → frontend'e API ile verilir (güvenli)
#   VAPID_PRIVATE_KEY=...    → SADECE sunucu tarafı (asla frontend/git)
#   VAPID_SUBJECT=mailto:alprn0604@gmail.com
#
# VPS (api.antalyanehari.xyz): subscribe, settings, test, vapid-public-key
# Vercel: günlük cron hatırlatması (/api/cron/daily-push-reminder)
#   → VAPID_* + DATABASE_URL (VPS ile aynı veritabanı)
#
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:alprn0604@gmail.com
# PUSH_REMINDER_TIMEZONE=Europe/Istanbul
# VITE_API_BASE_URL boş bırakılırsa: relative /api + Vite proxy (yalnızca dev)
# Uzak API kullanmak için:
# VITE_API_PROXY_TARGET=https://api.antalyanehari.xyz/api

# ─── Production yayınlama (pnpm deploy:prod / pnpm yayinla) ─────────────────
# Vercel Deploy Hook — Settings → Git → Deploy Hooks → Production branch
# VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
# Alternatif: Vercel CLI (npx vercel link sonrası)
# VERCEL_TOKEN=
