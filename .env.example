# ─── Yerel geliştirme (örnek) ───────────────────────────────────────────────
# Kökten kopyalayın: cp .env.example artifacts/api-server/.env

# api-server (zorunlu)
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
ADMIN_EMAIL=admin@ornek.com

# CORS + cross-site sid cookie (Railway/Render API’de zorunlu)
# FRONTEND_URL=https://workspaceveli-bilgilendirme-production.up.railway.app
# CORS_ORIGINS=https://xxx-preview.up.railway.app
# NODE_ENV=production
# (Railway’de RAILWAY_ENVIRONMENT otomatik; cookie cross-site açılır)

# ─── Vercel (Build & Development Settings → Environment Variables) ─────────
# VITE_API_BASE_URL=https://tedris-vbs-api.onrender.com/api

# ─── Yerel veli-bilgilendirme (isteğe bağlı; varsayılan: Vite /api proxy) ──
# artifacts/veli-bilgilendirme/.env.local
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_PROXY_TARGET=https://workspaceapi-server-production-c211.up.railway.app
