# Nehari Veli Bilgilendirme — Vite ortam değişkenleri
# Kök dizinden kopyalayın: cp artifacts/veli-bilgilendirme/.env.example ../../.env.local
# (vite.config.ts envDir proje kökünü okur)

# Yerel geliştirme: api-server (artifacts/api-server, PORT=3001)
# Davet showcase + oturum bu adrese gider; giriş de aynı API üzerinden yapılmalıdır.
VITE_API_BASE_URL=http://localhost:3001/api

# Vite dev proxy hedefi (VITE_API_BASE_URL boş bırakılırsa relative /api için)
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Canlı örnek:
# VITE_API_BASE_URL=https://api.antalyanehari.xyz/api

# VPS kayıt API anahtarı (VBS ana modülü; showcase upload için gerekmez)
# VITE_PROJECT_API_KEY=your_project_api_key_here
