{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/veli-bilgilendirme build",
  "outputDirectory": "artifacts/veli-bilgilendirme/dist/public",
  "functions": {
    "api/admin/repair-app-user-auth-links.ts": {
      "maxDuration": 300,
      "includeFiles": "api/_server/tedris-repair/**"
    }
  },
  "rewrites": [
    { "source": "/api/admin/repair-app-user-auth-links", "destination": "/api/admin/repair-app-user-auth-links" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
