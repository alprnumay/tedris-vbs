{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "node scripts/bundle-repair-dry-run.mjs && pnpm --filter @workspace/veli-bilgilendirme build",
  "outputDirectory": "artifacts/veli-bilgilendirme/dist/public",
  "functions": {
    "api/admin/repair-app-user-auth-links.js": {
      "maxDuration": 60,
      "includeFiles": "api/lib/repair-dry-run.cjs"
    },
    "api/push/*.js": {
      "maxDuration": 30,
      "includeFiles": "api/lib/push-vercel.cjs"
    },
    "api/cron/daily-push-reminder.js": {
      "maxDuration": 60,
      "includeFiles": "api/lib/push-vercel.cjs"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-push-reminder",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
